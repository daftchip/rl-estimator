{
  "version": 2,
  "functions": {
    "api/analyse.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/compare.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/api/analyse", "dest": "/analyse.js" },
    { "src": "/api/compare", "dest": "/compare.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
