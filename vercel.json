{
  "version": 2,
  "functions": {
    "api/analyse.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/compare.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/api/analyse", "dest": "/api/analyse.js" },
    { "src": "/api/compare", "dest": "/api/compare.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "api": {
    "bodyParser": {
      "sizeLimit": "20mb"
    }
  }
}
